# Kendi "Apple Development" sertifikanın SHA-1 değeri. Bulmak için:
#   security find-identity -v -p codesigning
# ("Apple Development: <adın>" satırındaki 40 haneli değer). Bu dosyayı signing.env olarak kopyala; signing.env git'e girmez.
UTIL_SIGN_IDENTITY=<SHA-1 of your Apple Development certificate>
